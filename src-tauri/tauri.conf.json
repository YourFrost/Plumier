{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plumier",
  "version": "0.2.0",
  "identifier": "fr.plumier.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Plumier", "width": 1320, "height": 840, "minWidth": 960, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["French"], "installMode": "currentUser" } }
  }
}
